# Placeholders only. Run `make bootstrap` to create .env and generate every credential.
# Never commit .env.

# development | test | production
ENV=production

# Host ports (always bound to 127.0.0.1)
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
GATEWAY_PORT=8000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Generated by `make bootstrap`
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
GATEWAY_DB_PASSWORD=
GATEWAY_MIGRATOR_DB_PASSWORD=
ORDERS_DB_PASSWORD=
ORDERS_MIGRATOR_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_USER=
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
WEB_CLIENT_SECRET=
DEMO_USER_PASSWORD=

# Keycloak
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# LLM provider: scripted | anthropic | openai_compatible | ollama
# `scripted` needs no network access and is used by the test suite.
LLM_PROVIDER=scripted
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
